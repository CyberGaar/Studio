model WebsiteScan {
  id              String   @id @default(uuid())
  url             String   @unique
  domain          String
  siteType        String   @map("site_type")
  tier            String   @default("Website")
  platformConfidence Int   @default(0) @map("platform_confidence")
  subCategory     String   @default("Website") @map("sub_category")
  complianceScore Int      @map("compliance_score")
  scoreBreakdown  Json     @map("score_breakdown")
  missingPolicies String[] @map("missing_policies")
  hsts            Boolean
  csp             Boolean
  xFrameOptions   Boolean  @map("x_frame_options")
  xContentTypeOptions Boolean @map("x_content_type_options")
  referrerPolicy  Boolean  @map("referrer_policy")
  secretsCount    Int      @map("secrets_count")
  maliciousCount  Int      @map("malicious_count")
