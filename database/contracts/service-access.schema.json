{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybergaar.com/schemas/service-access.schema.json",
  "title": "CyberGaar service database access contract",
  "type": "object",
  "required": ["contractVersion", "schemaSha256", "migrationRole", "services"],
  "properties": {
    "$schema": { "type": "string" },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "migrationRole": { "type": "string", "pattern": "^cybergaar_[a-z_]+$" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["service", "role", "read", "write"],
        "properties": {
          "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "role": { "type": "string", "pattern": "^cybergaar_[a-z_]+$" },
          "allTables": { "type": "boolean" },
          "read": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "write": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "columnUpdates": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "deniedColumnUpdate": {
            "type": "object",
            "required": ["table", "column"],
            "properties": {
              "table": { "type": "string" },
              "column": { "type": "string" }
            },
            "additionalProperties": false
          },
          "deniedProbe": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
